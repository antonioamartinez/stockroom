<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:vm="clr-namespace:Stockroom.Presentation.ViewModels;assembly=Stockroom.Presentation">

  <DataTemplate DataType="{x:Type vm:ItemListViewModel}">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="Items" Style="{StaticResource PageTitleStyle}" />

      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
          <Button Content="Add" Command="{Binding AddCommand}" Style="{StaticResource PrimaryButtonStyle}" />
          <Button Content="Edit" Command="{Binding EditCommand}" />
          <Button Content="Delete" Command="{Binding DeleteCommand}" />
          <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
          <StackPanel>
            <TextBlock Text="Search SKU, name or category" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Width="260"
                     Margin="0,0,16,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Esc clears the search">
              <TextBox.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
              </TextBox.InputBindings>
            </TextBox>
          </StackPanel>
          <CheckBox VerticalAlignment="Bottom" Margin="0,0,0,6" Content="Low stock only" IsChecked="{Binding LowStockOnly}" />
        </StackPanel>
      </DockPanel>

      <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Text="{Binding Summary}" Style="{StaticResource MutedTextStyle}" />

      <DataGrid ItemsSource="{Binding Items}"
                SelectedItem="{Binding SelectedItem}"
                RowStyle="{StaticResource InventoryRowStyle}">
        <!-- MouseDoubleClick is an event; the behavior forwards it to the command. -->
        <b:Interaction.Triggers>
          <b:EventTrigger EventName="MouseDoubleClick">
            <b:InvokeCommandAction Command="{Binding EditCommand}" />
          </b:EventTrigger>
        </b:Interaction.Triggers>
        <DataGrid.Columns>
          <DataGridTextColumn Width="130" Header="SKU" Binding="{Binding Sku, Mode=OneWay}" />
          <DataGridTextColumn Width="*" Header="Name" Binding="{Binding Name, Mode=OneWay}" />
          <DataGridTextColumn Width="130" Header="Category" Binding="{Binding Category, Mode=OneWay}" />
          <DataGridTextColumn Width="90" Header="On hand" Binding="{Binding QuantityOnHand, Mode=OneWay}" ElementStyle="{StaticResource NumberCellStyle}" />
          <DataGridTextColumn Width="90" Header="Reorder at" Binding="{Binding ReorderLevel, Mode=OneWay}" ElementStyle="{StaticResource NumberCellStyle}" />
          <DataGridTextColumn Width="90" Header="Unit cost" Binding="{Binding UnitCost, Mode=OneWay, StringFormat={}{0:C}}" ElementStyle="{StaticResource NumberCellStyle}" />
          <DataGridTextColumn Width="100" Header="Value" Binding="{Binding StockValue, Mode=OneWay, StringFormat={}{0:C}}" ElementStyle="{StaticResource NumberCellStyle}" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </DataTemplate>

</ResourceDictionary>
