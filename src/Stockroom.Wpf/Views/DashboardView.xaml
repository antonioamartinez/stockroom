<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:vm="clr-namespace:Stockroom.Presentation.ViewModels;assembly=Stockroom.Presentation">

  <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
    <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="Dashboard" Style="{StaticResource PageTitleStyle}" />

      <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,24">
        <Border Margin="0,0,12,0" Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Items" Style="{StaticResource FieldLabelStyle}" />
            <TextBlock Text="{Binding ItemCount}" Style="{StaticResource StatValueStyle}" />
          </StackPanel>
        </Border>
        <Border Margin="6,0" Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Units on hand" Style="{StaticResource FieldLabelStyle}" />
            <TextBlock Text="{Binding TotalUnits, StringFormat={}{0:N0}}" Style="{StaticResource StatValueStyle}" />
          </StackPanel>
        </Border>
        <Border Margin="12,0,0,0" Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Text="Stock value" Style="{StaticResource FieldLabelStyle}" />
            <TextBlock Text="{Binding StockValue, StringFormat={}{0:C}}" Style="{StaticResource StatValueStyle}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <TextBlock DockPanel.Dock="Top" Text="Needs reordering" Style="{StaticResource SectionTitleStyle}" />

      <TextBlock DockPanel.Dock="Top" Text="Nothing is at or below its reorder level.">
        <TextBlock.Style>
          <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding HasLowStock}" Value="False">
                <Setter Property="Visibility" Value="Visible" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <DataGrid ItemsSource="{Binding LowStockItems}"
                SelectedItem="{Binding SelectedLowStockItem}"
                Visibility="{Binding HasLowStock, Converter={StaticResource BoolToVisibility}}"
                ToolTip="Double-click an item to open it">
        <b:Interaction.Triggers>
          <b:EventTrigger EventName="MouseDoubleClick">
            <b:InvokeCommandAction Command="{Binding OpenSelectedCommand}" />
          </b:EventTrigger>
        </b:Interaction.Triggers>
        <DataGrid.Columns>
          <DataGridTextColumn Width="140" Header="SKU" Binding="{Binding Sku, Mode=OneWay}" />
          <DataGridTextColumn Width="*" Header="Name" Binding="{Binding Name, Mode=OneWay}" />
          <DataGridTextColumn Width="100" Header="On hand" Binding="{Binding QuantityOnHand, Mode=OneWay}" ElementStyle="{StaticResource NumberCellStyle}" />
          <DataGridTextColumn Width="100" Header="Reorder at" Binding="{Binding ReorderLevel, Mode=OneWay}" ElementStyle="{StaticResource NumberCellStyle}" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
  </DataTemplate>

</ResourceDictionary>
