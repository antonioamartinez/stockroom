<!--
  The main window. No x:Class, so there is no code-behind file. Program.cs loads it and sets the
  DataContext to ShellViewModel. The ContentControl shows whatever view model navigation has made
  current, and WPF picks its view from the DataTemplates in Views/.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        Title="{Binding Title}"
        Width="1080"
        Height="700"
        MinWidth="800"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13">

  <!-- Loaded is an event, so a behavior turns it into a command. -->
  <b:Interaction.Triggers>
    <b:EventTrigger EventName="Loaded">
      <b:InvokeCommandAction Command="{Binding InitializeCommand}" />
    </b:EventTrigger>
  </b:Interaction.Triggers>

  <DockPanel>
    <Border DockPanel.Dock="Left" Width="190" Background="{StaticResource SidebarBrush}">
      <StackPanel Margin="0,16,0,0">
        <TextBlock Margin="20,0,0,20"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="White"
                   Text="{Binding Title}" />
        <Button Content="Dashboard" Command="{Binding ShowDashboardCommand}" Style="{StaticResource NavButtonStyle}" />
        <Button Content="Items" Command="{Binding ShowItemsCommand}" Style="{StaticResource NavButtonStyle}" />
        <Button Content="Back" Command="{Binding GoBackCommand}" Style="{StaticResource NavButtonStyle}" />
      </StackPanel>
    </Border>

    <ContentControl Margin="28,24" Content="{Binding Navigation.Current}" Focusable="False" />
  </DockPanel>
</Window>
