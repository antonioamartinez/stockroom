<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Colours -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F5F6F8" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SidebarBrush" Color="#1F2933" />
  <SolidColorBrush x:Key="SidebarTextBrush" Color="#E4E7EB" />
  <SolidColorBrush x:Key="AccentBrush" Color="#2458C6" />
  <SolidColorBrush x:Key="LineBrush" Color="#D5DAE1" />
  <SolidColorBrush x:Key="TextBrush" Color="#1F2933" />
  <SolidColorBrush x:Key="MutedTextBrush" Color="#5F6B7A" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#B3261E" />
  <SolidColorBrush x:Key="WarningBrush" Color="#9A4A00" />

  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

  <!-- Text -->
  <Style x:Key="PageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Margin" Value="0,0,0,16" />
  </Style>

  <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>

  <Style x:Key="MutedTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
  </Style>

  <Style x:Key="StatValueStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
  </Style>

  <Style x:Key="CardStyle" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <!--
    Validation. The binding engine reads INotifyDataErrorInfo from the view model and shows the
    current error under the field. "/ErrorContent" binds to the current item of Validation.Errors,
    which avoids the binding warnings an index like [0] causes when the list empties.
  -->
  <ControlTemplate x:Key="FieldErrorTemplate">
    <StackPanel>
      <Border BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1" CornerRadius="2">
        <AdornedElementPlaceholder />
      </Border>
      <TextBlock Margin="0,2,0,0"
                 FontSize="11"
                 Foreground="{StaticResource ErrorBrush}"
                 Text="{Binding /ErrorContent}" />
    </StackPanel>
  </ControlTemplate>

  <Style TargetType="TextBox">
    <Setter Property="Padding" Value="6,4" />
    <!-- Leaves room for the error line the template draws below the box. -->
    <Setter Property="Margin" Value="0,0,0,20" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="Validation.ErrorTemplate" Value="{StaticResource FieldErrorTemplate}" />
    <Style.Triggers>
      <Trigger Property="Validation.HasError" Value="True">
        <Setter Property="ToolTip" Value="{Binding (Validation.Errors)/ErrorContent, RelativeSource={RelativeSource Self}}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Buttons -->
  <Style TargetType="Button">
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.7" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Margin" Value="8,2" />
  </Style>

  <!-- Grids -->
  <Style TargetType="DataGrid">
    <Setter Property="AutoGenerateColumns" Value="False" />
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="CanUserAddRows" Value="False" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="HeadersVisibility" Value="Column" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="RowHeight" Value="30" />
  </Style>

  <!-- Rows for items at or below their reorder level stand out. Bound to InventoryItem.IsLowStock. -->
  <Style x:Key="InventoryRowStyle" TargetType="DataGridRow">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsLowStock}" Value="True">
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="NumberCellStyle" TargetType="TextBlock">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>

</ResourceDictionary>
